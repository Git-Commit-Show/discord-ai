{
  "name": "discord-ai",
  "version": "1.1.0",
  "description": "AI-powered Discord bot powered by ResilientLLM",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "mocha --require ./test/helpers/silenceConsole.js test/01-spam.test.js test/llmService.test.js test/02-intro-gates.test.js test/introductionValidator.test.js test/03-welcome-and-errors.test.js test/deletedIntroduction.test.js",
    "test:e2e": "mocha --require ./test/helpers/silenceConsole.js \"test/**/*.e2e.test.js\" --timeout 60000",
    "setup-systemd": "bash scripts/setup-systemd.sh"
  },
  "keywords": [
    "discord",
    "discord-ai",
    "discord-bot",
    "resilient-llm",
    "openrouter",
    "ai",
    "llm",
    "spam-filter",
    "community-moderation",
    "moderation"
  ],
  "author": "Git-Commit-Show",
  "license": "Apache-2.0",
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "resilient-llm": "^1.8.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.8.0",
    "nodemon": "^3.1.14",
    "sinon": "^22.1.0"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    }
  }
} 