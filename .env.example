# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------

# How to get DISCORD_TOKEN:
#   1. Open https://discord.com/developers/applications
#   2. Create (or select) an application → Bot → Add Bot (if needed)
#   3. Under Token, click Reset Token / Copy
#   4. Enable Privileged Gateway Intents: Message Content Intent, Server Members Intent
#   5. Invite the bot via OAuth2 → URL Generator (scope: bot) with permissions:
#      View Channels, Send Messages, Read Message History, Embed Links, Manage Roles
DISCORD_TOKEN=#secret

# How to get INTRO_CHANNEL_ID:
#   1. In Discord: User Settings → App Settings → Advanced → enable Developer Mode
#   2. Create or pick your introductions channel (e.g. #introductions)
#   3. Right-click the channel → Copy Channel ID
INTRO_CHANNEL_ID=#1234567890123456789

# -----------------------------------------------------------------------------
# AI (OpenRouter)
# -----------------------------------------------------------------------------

# LLM provider name used by the bot (currently only openrouter)
AI_SERVICE=openrouter

# How to get MODEL:
#   1. Browse models at https://openrouter.ai/models
#   2. Copy a model id (slug) from the model page
# Examples:
#   openrouter/auto
#   deepseek/deepseek-chat-v3-0324:free
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
MODEL=openrouter/free

# How to get OPENROUTER_API_KEY:
#   1. Sign in at https://openrouter.ai
#   2. Open https://openrouter.ai/keys
#   3. Create a key → copy it (starts with sk-or-v1-)
OPENROUTER_API_KEY=#sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# New-member role cleanup
# -----------------------------------------------------------------------------

# How to get NEW_MEMBER_ROLE_ID:
#   1. In Discord: enable Developer Mode (same as above)
#   2. Server Settings → Roles → create/select the temporary "new member" role
#   3. Right-click the role → Copy Role ID
#   Note: the bot's role must be above this role and have Manage Roles
#   Also enable Server Members Intent (Bot → Privileged Gateway Intents)
NEW_MEMBER_ROLE_ID=#9876543210987654321

# Set how many days after join before the new-member role is removed (default: 7)
# Choose any positive integer that matches your onboarding window
NEW_MEMBER_DAYS=7

# How often the cleanup job runs, in hours (default: 24)
# Choose any positive number; lower = more frequent scans
ROLE_CLEANUP_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# Pagination
# -----------------------------------------------------------------------------

# Page size for Discord REST list calls (e.g. member cleanup). Default: 1000
# Discord caps List Guild Members at 1000; values outside 1–1000 are clamped
PAGINATION_SIZE=1000

# -----------------------------------------------------------------------------
# Moderator notifications (planned)
# -----------------------------------------------------------------------------

# How to set NOTIFICATION_MODE:
#   dm      → bot DMs a user when spam is detected
#   channel → bot posts in a mod/log channel
NOTIFICATION_MODE=channel

# How to get NOTIFICATION_TARGET_ID:
#   If NOTIFICATION_MODE=dm:
#     Right-click the mod user → Copy User ID
#   If NOTIFICATION_MODE=channel:
#     Right-click the mod/log channel → Copy Channel ID
NOTIFICATION_TARGET_ID=#1122334455667788990
